,"evidence_text_sha256":"bd0739b01685f2ba4b8fccfd47885ef9d84780f1d029ac1bc789cf382eddb1f5","locator_ids":["2be6aa879d2db91a97ae05ed48f43e33b6edf58bcdafba2364ae9bb07b55369a"],"lineage_ids":["d5fb80236055e2e7db924d3c3324c23db044334f0ac76907b4a99df722cbb084","d5fb80236055e2e7db924d3c3324c23db044334f0ac76907b4a99df722cbb084","d5fb80236055e2e7db924d3c3324c23db044334f0ac76907b4a99df722cbb084"],"warnings":[]},{"evidence_id":"E4","chunk_id":"3f658b22198fa39451978f7c75cb8e5d7af5c4b6305b58dbca089bffe524845b","parent_id":"mars-europe-2013-06-vol21-no6:page-0000","evidence_text":"EU-27 level was also revised upwards. Rapeseed yield estimates were\nrevised slightly downwards for the EU-27, and are currently forecast\nto be below last year’s level. The forecast for grain maize was revised\nupwards and is now clearly above last year’s yield at EU-27 level.\nPotatoes, and to a minor degree sugar beets, suffered a downward\nyield forecast revision.","evidence_text_sha256":"fe25ec16f95290eb25ec43fb93e150beeb136a92384160052e84973df46a5c9c","locator_ids":["c8fbd1c1ec23f2db3613e535c6c420d8d48351ae2369a40ec0d75c8002531fd4","b1bb7ea5fefe11c3b0cb4035a85c730c1c3c666cba13482b6b72b250f8c40124","39093734c1708399ee8f710484a7f3982d963855db1defad9e34c4adaffbdd9e","0b052e4738e22f1ecb3e1532bcf71c7392bcaff16899e796ea74ecde223390b6","c8d1fe165822c1da7c503df5cb9196e342da19dde631752de185592654595f92","c5cc73c562db9df99570679a8075f007e04e5a7d7fc4ed648901505b155c10be","12d2e5dd78ffe0a94753845e4747060664bb1df4bcfcbdaf0ba9fc9865da7d01","2fdf1879f25170c7c0674f6c45ca77fe0c2c506354bae30d919f664b20d106fc"],"lineage_ids":["7ff4afadf0be1a71996203e245913337fd78f429841e3b71a141b9b4579dda25","7ff4afadf0be1a71996203e245913337fd78f429841e3b71a141b9b4579dda25","7ff4afadf0be1a71996203e245913337fd78f429841e3b71a141b9b4579dda25","7ff4afadf0be1a71996203e245913337fd78f429841e3b71a141b9b4579dda25","7ff4afadf0be1a71996203e245913337fd78f429841e3b71a141b9b4579dda25","7ff4afadf0be1a71996203e245913337fd78f429841e3b71a141b9b4579d